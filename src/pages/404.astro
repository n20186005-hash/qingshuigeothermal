---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="找不到頁面" noindex={true}>
  <main class="not-found" id="main-content">
    <div>
      <span>404</span>
      <h1>這條山路沒有通往這裡</h1>
      <p>頁面可能已移動，回到首頁重新查看清水地熱的行前資訊。</p>
      <a class="button button-dark" href="/">返回首頁</a>
    </div>
  </main>
</BaseLayout>
